# Kamome Strait: git keeps what builds and publishes the game (src/, build.js, build/ for GitHub Pages, site/, .github/) and the
# project's own records. Everything else in the folder stays out.

# reference material and outputs kept only on the disk
# the games in development: their pages (node build.js --dev) stay off GitHub until the user releases them
dev/
References/
Claude outputs/
*.xlsx

# working records: blueprints, test baselines, research notes and plans (not needed to build or run the game)
Blueprints/
baseline/
docs/
PLAN_*.md

# the old copy-and-check sync's files, and git bundles carried to the workspace
_sync.tar
_sync_delete.txt
_repo.md5
*.bundle

# tools' scratch and the system's own files
node_modules/
__pycache__/
*.pyc
build/tests/
Thumbs.db
desktop.ini
.DS_Store
